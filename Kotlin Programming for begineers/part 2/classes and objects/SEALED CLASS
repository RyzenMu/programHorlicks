sealed class NetworkResult {
    // Subclass 1: Holds a String of data
    data class Success(val data: String) : NetworkResult()
     // Subclass 2: Holds an error message
    data class Error(val message: String) : NetworkResult()
     // Subclass 3: Holds nothing (we use 'object' because it's a singleton)
    object Loading : NetworkResult()

fun handleResult(result: NetworkResult) {
    when (result) {
        is NetworkResult.Success -> {
            println("Download complete: ${result.data}")
        }
        is NetworkResult.Error -> {
            println("Something went wrong: ${result.message}")
        }
        is NetworkResult.Loading -> {
            println("Please wait...")
        }
    }
